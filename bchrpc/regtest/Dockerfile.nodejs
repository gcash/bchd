# Start from a Debian image with Node.js 22.  None of the test dependencies
# is a native module, so the slim image needs no build tools.
FROM node:22-slim

# Copy the local package files to the container's workspace.
ADD . /go/src/github.com/gcash/bchd

# Switch to the correct working directory.
WORKDIR /go/src/github.com/gcash/bchd/bchrpc/regtest

# Create the data volume.
VOLUME ["/data"]
